        attribute grin:
            "/fg/a_grin.png"
        attribute smug:
            "/fg/a_smug.png"
        attribute talk:
            "/fg/a_talk.png"

    attribute blush:
        "/fg/a_blush.png"

    attribute question:
        "/fg/a_question.png"



